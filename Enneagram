const App=()=>{
  const [mode,setMode]=useState('persona');
  const [deck,setDeck]=useState(()=>shuffle(_DATA));
  const [drawn,setDrawn]=useState([]);
  const [hovered,setHovered]=useState(null);
  const [copied,setCopied]=useState(false);

  // 原生 CSS zoom 等比例縮放控制：固定 1040px 黃金版面，畫面縮小時整頁等比例縮小，高度 100% 自然延伸絕不裁切！
  const BASE_WIDTH = 1040;
  const [zoomVal,setZoomVal]=useState(1);

  useEffect(()=>{
    const handleResize=()=>{
      const vw = document.documentElement.clientWidth || window.innerWidth;
      setZoomVal(vw < BASE_WIDTH ? vw / BASE_WIDTH : 1);
    };
    handleResize();
    window.addEventListener('resize',handleResize);
    return ()=>window.removeEventListener('resize',handleResize);
  },[]);

  const maxCards = mode === 'persona' ? 2 : 3;
  const remainingDeck = deck.filter(c=>!drawn.some(d=>d.id===c.id));

  const switchMode = newMode => {
    setMode(newMode);
    setDrawn([]);
    setHovered(null);
    setCopied(false);
    setDeck(shuffle(_DATA));
  };

  const pickCard=card=>{
    if(drawn.length>=maxCards||drawn.some(d=>d.id===card.id))return;
    setHovered(null);
    setDrawn([...drawn,card]);
  };

  const reset=()=>{
    setDrawn([]);
    setHovered(null);
    setCopied(false);
    setDeck(shuffle(_DATA));
  };

  const copyResultToClipboard=()=>{
    const text = mode === 'persona'
      ? `【植物九型・主副人格檢測】我抽到的是：主人格「${drawn[0].oil}・${drawn[0].name}」、副人格「${drawn[1].oil}・${drawn[1].name}」，想預約專屬人格深度解讀與客製守護調香！`
