<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>植物九型人格・精油占卜指引</title>
<script src="./assets/vendor/tailwind-3.4.17.js"></script>
<link rel="stylesheet" href="./assets/fonts/fonts.css">
<script src="./assets/vendor/react-18.3.1.min.js" crossorigin></script>
<script src="./assets/vendor/react-dom-18.3.1.min.js" crossorigin></script>
<style>
html,body{background:#080706;color:#d4af37;font-family:'Noto Serif TC',serif;margin:0;padding:0;min-height:100vh;-webkit-user-select:none;user-select:none;overflow-x:hidden}
#root, #root *{font-family:'Noto Serif TC',serif}
.mucha-arch{border-radius:150px 150px 10px 10px}
.dark-card-shadow{box-shadow:0 18px 42px -8px rgba(0,0,0,0.85),0 0 1px 1px rgba(212,175,55,0.25)}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:#0a0908}::-webkit-scrollbar-thumb{background:#4a3e28;border-radius:3px}

html { font-size:100%; }
.oracle-panel { padding:clamp(1rem,4vw,3rem); }
.oracle-panel header h1 { font-size:clamp(1.75rem,5vw,3rem); letter-spacing:.12em; }
.oracle-panel header .inline-flex { gap:.6rem; }
.oracle-panel header .flex { flex-wrap:wrap; }
.oracle-panel header button { padding:.75rem 1rem; font-size:.875rem; }
.oracle-slots > div { width:100%; min-width:0; }
.oracle-panel p { overflow-wrap:anywhere; }
.oracle-panel .flex.items-center.justify-between { flex-wrap:wrap; }
.oracle-panel a { white-space:normal; overflow-wrap:anywhere; }
.oracle-panel svg { animation:none !important; }
@media(max-width:600px) {
 .oracle-panel .px-10, .oracle-panel .p-8, .oracle-panel .p-7 { padding:1.25rem; }
 .oracle-panel .px-6 { padding-left:1rem; padding-right:1rem; }
 .oracle-panel .text-2xl { font-size:1.25rem; }
 .oracle-panel .w-32 { width:3rem; }
}

.oracle-deck { position:relative; width:192px; height:320px; margin:1rem auto 3rem; }
@media(min-width:768px) { .oracle-deck { width:224px; height:380px; } }
.oracle-deck-top { position:relative; width:100%; height:100%; cursor:pointer; background:linear-gradient(135deg,#1c1813,#0e0c0a,#070605); box-shadow:0 20px 35px #0008; transition:transform .7s ease,box-shadow .7s ease; }
.oracle-reference-inner { position:relative; width:100%; height:100%; border:1px solid #d4af3766; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.oracle-reference-mandala { width:94%; height:94%; opacity:.9; transition:transform 1s; }
.oracle-reference-label { position:absolute; bottom:1.25rem; border:1px solid #d4af3766; border-radius:999px; padding:.25rem 1rem; background:#080706d9; color:#d4af37; font-size:.5625rem; letter-spacing:.35em; text-transform:uppercase; }
@media(hover:hover) and (pointer:fine) {
 .oracle-deck-top:not(:disabled):hover { transform:translateY(-12px); box-shadow:0 0 35px #d4af3747; }
 .oracle-deck-top:not(:disabled):hover .oracle-reference-mandala { transform:scale(1.05); }
}
.oracle-deck-top:disabled { cursor:wait; transition:none; }
.oracle-deck-top .oracle-reference-geometry { transform-box:view-box; transform-origin:center; animation:oracle-reference-spin 50s linear infinite reverse; }
.oracle-deck-top .oracle-reference-petals { transform-box:view-box; transform-origin:center; animation:oracle-reference-spin 70s linear infinite; }
@keyframes oracle-reference-spin { to { transform:rotate(360deg); } }
.oracle-reference-icon { animation:oracle-reference-glow 4s infinite ease-in-out; }
@keyframes oracle-reference-glow { 0%,100% { filter:drop-shadow(0 0 6px #d4af3759); } 50% { filter:drop-shadow(0 0 14px #d4af37b3); } }
.oracle-flip-card { position:relative; animation:oracle-reference-reveal .8s cubic-bezier(.16,1,.3,1) both; }
.oracle-result-back { display:none; }
@keyframes oracle-reference-reveal { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
@media(prefers-reduced-motion:reduce) {
 .oracle-deck-top,.oracle-reference-mandala { transition:none; }
 .oracle-deck-top:not(:disabled):hover { transform:none; }
 .oracle-deck-top .origin-center,.oracle-reference-icon,.oracle-flip-card { animation:none; }
}

.oracle-background .origin-center { transform-box:view-box; transform-origin:center; animation:oracle-background-turn 120s linear infinite; }
.oracle-background .origin-center ~ .origin-center { animation-duration:80s; animation-direction:reverse; }
@keyframes oracle-background-turn { to { transform:rotate(360deg); } }
@media(prefers-reduced-motion:reduce) { .oracle-background .origin-center { animation:none; } }
</style>
<script>
document.addEventListener('contextmenu',e=>e.preventDefault());
document.addEventListener('keydown',e=>{if(e.key==='F12'||(e.ctrlKey&&e.shiftKey&&['I','J','C'].includes(e.key.toUpperCase()))||(e.ctrlKey&&['U','S','C'].includes(e.key.toUpperCase()))||(e.metaKey&&e.altKey&&['I','U','C'].includes(e.key.toUpperCase())))e.preventDefault()});
</script>
</head>
<body>
<div id="root"></div>
<script src="./assets/enneagram.min.js?v=4ab72786af347756"></script>
</body>
</html>
