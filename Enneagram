<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>植物九型人格・精油占卜指引</title>
<script src="./assets/vendor/tailwind-3.4.17.js"></script>
<link rel="stylesheet" href="./assets/fonts/fonts.css">
<script src="./assets/vendor/react-18.3.1.min.js" crossorigin></script>
<script src="./assets/vendor/react-dom-18.3.1.min.js" crossorigin></script>
<style>
html,body{background:#080706;color:#d4af37;font-family:'Noto Serif TC',serif;margin:0;padding:0;min-height:100vh;-webkit-user-select:none;user-select:none;overflow-x:hidden}
#root, #root *{font-family:'Noto Serif TC',serif}
.mucha-arch{border-radius:150px 150px 10px 10px}
.dark-card-shadow{box-shadow:0 18px 42px -8px rgba(0,0,0,0.85),0 0 1px 1px rgba(212,175,55,0.25)}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:#0a0908}::-webkit-scrollbar-thumb{background:#4a3e28;border-radius:3px}

html { font-size:100%; }
.oracle-panel { padding:clamp(1rem,4vw,3rem); }
.oracle-panel header h1 { font-size:clamp(1.75rem,5vw,3rem); letter-spacing:.12em; }
.oracle-panel header .inline-flex { gap:.6rem; }
.oracle-panel header .flex { flex-wrap:wrap; }
.oracle-panel header button { padding:.75rem 1rem; font-size:.875rem; }
.oracle-slots > div { width:100%; min-width:0; }
.oracle-panel p { overflow-wrap:anywhere; }
.oracle-panel .flex.items-center.justify-between { flex-wrap:wrap; }
.oracle-panel a { white-space:normal; overflow-wrap:anywhere; }
.oracle-panel svg { animation:none !important; }
@media(max-width:600px) {
 .oracle-panel .px-10, .oracle-panel .p-8, .oracle-panel .p-7 { padding:1.25rem; }
 .oracle-panel .px-6 { padding-left:1rem; padding-right:1rem; }
 .oracle-panel .text-2xl { font-size:1.25rem; }
 .oracle-panel .w-32 { width:3rem; }
}

.oracle-deck { position:relative; width:140px; height:210px; margin:1rem auto 3rem; }
.oracle-deck-layer { position:absolute; inset:0; border:1px solid #d4af3759; border-radius:6px; background:#17130e; padding:1rem; pointer-events:none; }
.oracle-deck-top { position:relative; width:100%; height:100%; cursor:pointer; box-shadow:0 12px 26px #0008; }
.oracle-deck-top:not(:disabled):hover { border-color:#e7cf92; }
.oracle-deck-top:disabled { cursor:wait; }

.oracle-flip-card { position:relative; transform-style:preserve-3d; animation:oracle-result-flip .75s cubic-bezier(.25,.7,.25,1) both; }
.oracle-flip-card > :not(.oracle-result-back) { backface-visibility:hidden; transform:translateZ(1px); }
.oracle-result-back { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; border:1px solid #d4af3780; border-radius:6px; background:#120f0c; color:#d4af37; transform:rotateY(180deg); backface-visibility:hidden; }
@keyframes oracle-result-flip { from { transform:perspective(1200px) rotateY(180deg); } to { transform:perspective(1200px) rotateY(0deg); } }
@media(prefers-reduced-motion:reduce) { .oracle-flip-card { animation:none; } }

.oracle-background .origin-center { transform-box:view-box; transform-origin:center; animation:oracle-background-turn 120s linear infinite; }
.oracle-background .origin-center ~ .origin-center { animation-duration:80s; animation-direction:reverse; }
@keyframes oracle-background-turn { to { transform:rotate(360deg); } }
@media(prefers-reduced-motion:reduce) { .oracle-background .origin-center { animation:none; } }
</style>
<script>
document.addEventListener('contextmenu',e=>e.preventDefault());
document.addEventListener('keydown',e=>{if(e.key==='F12'||(e.ctrlKey&&e.shiftKey&&['I','J','C'].includes(e.key.toUpperCase()))||(e.ctrlKey&&['U','S','C'].includes(e.key.toUpperCase()))||(e.metaKey&&e.altKey&&['I','U','C'].includes(e.key.toUpperCase())))e.preventDefault()});
</script>
</head>
<body>
<div id="root"></div>
<script src="./assets/enneagram.min.js?v=0062f218ac2c2872"></script>
</body>
</html>
