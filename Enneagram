<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>植物九型人格・精油占卜指引</title>
<script src="./assets/vendor/tailwind-3.4.17.js"></script>
<link rel="stylesheet" href="./assets/fonts/fonts.css">
<script src="./assets/vendor/react-18.3.1.min.js" crossorigin></script>
<script src="./assets/vendor/react-dom-18.3.1.min.js" crossorigin></script>
<style>
html,body{background:#080706;color:#d4af37;font-family:'Cormorant Garamond','Noto Serif TC',serif;margin:0;padding:0;min-height:100vh;-webkit-user-select:none;user-select:none;overflow-x:hidden}
.font-cinzel{font-family:'Cinzel','Noto Serif TC',serif}
@keyframes fadeInUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.animate-fade-in{animation:fadeIn .5s ease-out forwards}
.animate-fade-in-up{animation:fadeInUp .6s cubic-bezier(.16,1,.3,1) forwards}
.mucha-arch{border-radius:150px 150px 10px 10px}
.dark-card-shadow{box-shadow:0 18px 42px -8px rgba(0,0,0,0.85),0 0 1px 1px rgba(212,175,55,0.25)}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:#0a0908}::-webkit-scrollbar-thumb{background:#4a3e28;border-radius:3px}
</style>
<script>
document.addEventListener('contextmenu',e=>e.preventDefault());
document.addEventListener('keydown',e=>{if(e.key==='F12'||(e.ctrlKey&&e.shiftKey&&['I','J','C'].includes(e.key.toUpperCase()))||(e.ctrlKey&&['U','S','C'].includes(e.key.toUpperCase()))||(e.metaKey&&e.altKey&&['I','U','C'].includes(e.key.toUpperCase())))e.preventDefault()});
</script>
</head>
<body>
<div id="root"></div>
<script src="./assets/enneagram.min.js"></script>
</body>
</html>
